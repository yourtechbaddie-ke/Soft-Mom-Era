# Soft Mom Era — Replit environment variables
# Never commit real API keys to GitHub.

# Preferred generic provider key.
AURA_API_KEY=

# Optional OpenAI-compatible endpoint.
# Leave blank to use the default OpenAI Chat Completions endpoint.
AURA_API_URL=

# Model name supported by the configured provider.
AURA_MODEL=gpt-4o-mini

# Replit supplies PORT automatically in deployment.
# PORT=3000
